# Public site URL used for canonical URLs, sitemap, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://www.cloudcertprep.com

# Optional privacy-conscious analytics. Leave unset for a no-op (no tracking).
# Supported values: "plausible"
NEXT_PUBLIC_ANALYTICS_PROVIDER=

# Google Search Console verification token (content attribute of the meta tag).
# Used in src/app/layout.tsx metadata.verification when set.
NEXT_PUBLIC_GSC_VERIFICATION=

# Display advertising. Do NOT enable until the ad network has approved the site
# and a consent flow is in place for your audience.
NEXT_PUBLIC_ADS_ENABLED=false
